# Package data (templates, DTD) is declared in pyproject.toml. This file only
# covers files that belong in the source distribution but not in the importable
# package — chiefly the manual pages, which distro packagers install from here.
include CHANGELOG.md
include man/*.md

# Manual pages rendered by `make man` during the release pipeline.
include man/termtosvg*.man.?

global-exclude __pycache__ *.py[cod]
